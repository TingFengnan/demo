#include <stdio.h>
int mycmp(char number[],char number1[]);
int main ()
{
	char string[10];
	char string1[10];
	int a;
	scanf("%s %s",&string,&string1);
	a=mycmp(string,string1);
	printf("%d",a);
	
}
int mycmp(char number[],char number1[])
{
	char *p,*q;
	int re;
	p=number,q=number1;
	while(1)
	{
		if(*p==*q){
			if(*p=='\0'){
				re=0;
				break;
			}
			p++;
			q++;
		}
		else{
			re=*p-*q;
		break;
		}
		
	}
return re;
}
