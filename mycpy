#include <stdio.h>
void mycpy(char string[],char string1[]);
int main()
{
	//写一个copy的函数，用指针，小心数组越界。
	char number[12],number1[12];
	 scanf("%s",number1);
	 mycpy(number,number1);
	 printf("%s %s",number,number1);
	 return 0;
}
void mycpy(char string[],char string1[])
{
	char *p=0;
	p=string1;
	int a=0;
	while(*p!='\0'){
		string[a]=*p;
		p++;
		a++;
	}
}
